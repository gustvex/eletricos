# Porta do servidor HTTP
PORT=3000

# Origens liberadas no CORS durante o desenvolvimento (separadas por virgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Onde os leads sao gravados (um JSON por linha)
LEADS_FILE=./data/leads.jsonl

# Limite de envios por IP na rota de leads
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10
